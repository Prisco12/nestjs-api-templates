NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_api?schema=public
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-before-running-seed
